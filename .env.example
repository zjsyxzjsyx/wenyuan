# Copy to .env and fill in. Defaults match docker-compose.yml.

# Milvus (docker compose service "standalone")
MILVUS_URI=http://localhost:19530

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=docrag
MYSQL_USER=docrag
MYSQL_PASSWORD=change-me
MYSQL_URL=mysql+pymysql://docrag:change-me@localhost:3306/docrag?charset=utf8mb4

# Redis: cache, rate limiting, Celery broker
REDIS_URL=redis://localhost:6379/0

# Host GPU model service (embedding + rerank)
MODEL_SERVER_URL=http://localhost:8001

# LLM: any OpenAI-compatible endpoint (DeepSeek / Qwen)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
