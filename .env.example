# Copy to .env and fill in. Defaults match docker-compose.yml.

# Milvus (docker compose service "standalone")
MILVUS_URI=http://127.0.0.1:19530

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=docrag
MYSQL_USER=docrag
MYSQL_PASSWORD=change-me
MYSQL_URL=mysql+pymysql://docrag:change-me@127.0.0.1:3306/docrag?charset=utf8mb4

# Redis: cache, rate limiting, Celery broker
REDIS_URL=redis://127.0.0.1:6379/0

# Host GPU model service (embedding + rerank)
MODEL_SERVER_URL=http://127.0.0.1:8001

# LLM: any OpenAI-compatible endpoint. Default is a local Ollama (any non-empty key works);
# for an API use e.g. LLM_BASE_URL=https://api.deepseek.com/v1, LLM_MODEL=deepseek-chat and your key.
# Questions over a private library always go to the local model.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
# When LLM_* is a remote API, point these at the local model: answers that use private notes go here.
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_MODEL=qwen3:8b

# GPU gate and per-user rate limit (see app/cache/limits.py; slots from the W3 load test on a 16 GB card)
GATE_SLOTS=2
GATE_PER_USER=2
GATE_MAX_WAIT_S=20
RATE_BURST=10
RATE_PER_MINUTE=20

# Eval judge for eval/answers.py (optional). Unset: the local model with thinking on, which shares the
# answering model's biases. A stronger API model, e.g. DeepSeek:
# JUDGE_BASE_URL=https://api.deepseek.com/v1
# JUDGE_API_KEY=
# JUDGE_MODEL=deepseek-chat
